# Copy to .env and fill in your own values. .env is gitignored.
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./support_agent.db

# --- Redis（检索缓存与限流共用） ---
# Leave empty to use the in-process implementation: everything still works, but
# cache hits are per-process and the rate limit is enforced per process.
# If Redis is unreachable the app degrades to that same in-process path after one
# failed attempt (then stops retrying for CACHE_FAILURE_COOLDOWN_SECONDS), so a
# dead Redis costs one slow request instead of slowing down every request.
# Check /health -> cache.degraded to see which path is active.
REDIS_URL=
CACHE_TTL_SECONDS=300
CACHE_FAILURE_COOLDOWN_SECONDS=30

# --- LLM (OpenAI-compatible) ---
# Remote calls are off by default. Enable only when company data policy allows it.
# The three model fields must also be set; otherwise /chat uses the local rule model.
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com    LLM_MODEL=<your-account-model>
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
ALLOW_REMOTE_LLM=false
PRIVACY_ROUTING_ENABLED=true
# Legacy optional local endpoint; current private-question flow uses the remote LLM when enabled.
# Setting these fields does not make private questions local-only. Ollama example:
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=qwen3-local:1.7b
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=local
# Optional public web lookup; only allowlisted product and generic fault terms are sent.
PUBLIC_SEARCH_API_KEY=

# --- Embeddings ---
# hash = zero-dependency fallback (character hashing, no semantics).
# onnx = local semantic model; needs `pip install -e ".[semantic]"` plus a model dir
#        containing tokenizer.json and onnx/model.onnx (see README).
# Switching backends changes the vector space: rebuild and re-ingest the corpus
#   python scripts/ingest_smartpv.py --source <corpus dir> --reset
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL_PATH=
# Leave unset to use the backend default (hash 384 / onnx 512).
# EMBEDDING_DIMENSION=512
# --- Algorithm parameters ---
# Edit config/agent.toml; keep secrets/endpoints/deployment settings in this file.
# Optional alternative baseline and experiment overlay (restart after changes):
# AGENT_CONFIG_FILE=config/agent.toml
# AGENT_EXPERIMENT_FILE=config/experiments/longer_context.toml
# Legacy algorithm env keys still override the baseline. Migrate them once:
# python scripts/manage_tuning.py --migrate-env
# Scope retrieval to one corpus. Leave empty to search every corpus in the DB.
# The ingest scripts write the same corpus_id, so this is what keeps an
# imported batch and the running service looking at the same set of chunks.
RETRIEVAL_CORPUS_ID=
# Per-user /chat quota. 0 disables limiting.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

CONFIRMATION_SECRET=replace-this-before-deployment
AUTH_ENABLED=true
MAX_UPLOAD_BYTES=5242880

# Operations framework: local backups and rotating service logs
BACKUP_DIR=.backups
KNOWLEDGE_BASE_DIR=knowledge_base
LOG_DIR=.logs
INPUT_TIMEOUT_SECONDS=120
AUTOMATIC_BACKUP_ENABLED=true
AUTOMATIC_BACKUP_INTERVAL_HOURS=24
AUTOMATIC_BACKUP_KEEP=7
# Docker production: DEPLOY_ENV=production and independent 32+ character secret
# DEPLOY_ENV=production
# POSTGRES_PASSWORD=replace_with_a_strong_database_password
# API_BIND_HOST=127.0.0.1
